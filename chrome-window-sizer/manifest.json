{
  "manifest_version": 3,
  "name": "Window Sizer",
  "description": "Open or resize Chrome windows at custom sizes, capture the current size, and save named presets.",
  "version": "1.3.0",
  "action": {
    "default_title": "Size a Chrome window",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ]
}
